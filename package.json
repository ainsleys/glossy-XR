{
  "name": "glossy-xr",
  "version": "0.2.0",
  "description": "Glossy, rebuilt: spatially anchored, multi-user voice annotation for WebXR (successor to the 2016 BuzzFeed Open Lab WebVR prototype)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --disable-warning=ExperimentalWarning server/index.js",
    "client": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@sparkjsdev/spark": "^2.3.1",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^9.1.2",
    "iwer": "^2.6.0",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  }
}
